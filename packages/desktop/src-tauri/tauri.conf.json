{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mark 5",
  "version": "0.1.0",
  "identifier": "dev.mark5.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mark 5",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "additionalBrowserArgs": "--disable-gpu --js-flags=--optimize-for-size --disable-features=BackForwardCache,Translate,MediaRouter,OptimizationHints,msWebOOUI,msPdfOOUI --disable-background-networking --disable-component-update --disable-extensions --disable-sync --disable-default-apps --no-pings --disable-speech-api --renderer-process-limit=1"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}

{
  "name": "mark5-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Mark 5 — Ultra-lightweight AI-Native Markdown Editor powered by Tauri v2, Rust, and Muya",
  "scripts": {
    "dev": "pnpm --filter mark5-desktop tauri:dev",
    "build": "pnpm --filter mark5-desktop tauri:build",
    "build:ui": "pnpm --filter mark5-desktop build",
    "typecheck": "pnpm --filter @muyajs/core build:types && pnpm --filter mark5-desktop typecheck"
  },
  "packageManager": "pnpm@10.33.0"
}
